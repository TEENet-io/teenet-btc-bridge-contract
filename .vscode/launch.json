{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Mocha Current File",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
			"args": [
				"--no-timeouts",
				"${file}"
			],
			"internalConsoleOptions": "openOnSessionStart",
			"console": "integratedTerminal",
			"sourceMaps": true
		},
		{ 
			"name": "Debug ts script",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceRoot}",
			"args": [
				"${relativeFile}", 
				"0xfc19623370db3591f4472c767d8f237d064c4de4e8d71b58c607bdcf4543316e"
			],
			"runtimeArgs": [
				"-r",
				"ts-node/register"
			],
			"internalConsoleOptions": "openOnSessionStart",
			"console": "integratedTerminal",
			"sourceMaps": true
		}
	],
	"compounds": []
}